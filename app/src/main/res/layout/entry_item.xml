<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.EntryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/selectedCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/feedImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/feedTitle"
            app:layout_constraintStart_toEndOf="@+id/selectedCheckbox"
            app:layout_constraintTop_toTopOf="@+id/feedTitle"
            tools:src="@drawable/ic_rss_feed" />

        <TextView
            android:id="@+id/feedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintEnd_toStartOf="@+id/entryImage"
            app:layout_constraintStart_toEndOf="@+id/feedImage"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Feed Title" />

        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/entryImage"
            app:layout_constraintStart_toEndOf="@+id/selectedCheckbox"
            app:layout_constraintTop_toBottomOf="@+id/feedTitle"
            tools:text="Article Title" />

        <TextView
            android:id="@+id/entryPubDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOutline"
            app:layout_constraintEnd_toStartOf="@+id/entryImage"
            app:layout_constraintStart_toEndOf="@+id/selectedCheckbox"
            app:layout_constraintTop_toBottomOf="@+id/entryTitle"
            tools:text="2 hours ago" />

        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/selectedCheckbox"
            app:layout_constraintTop_toBottomOf="@+id/entryPubDate">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookmark_button"
                style="@style/Widget.App.SmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:minWidth="32dp"
                android:minHeight="32dp"
                app:icon="@drawable/ic_bookmark_outline"
                app:iconTint="?attr/colorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/more_button"
                style="@style/Widget.App.SmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:minWidth="32dp"
                android:minHeight="32dp"
                app:icon="@drawable/ic_menu"
                app:iconTint="?attr/colorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/extractionStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/status_dot_red"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/actionsContainer"
            app:layout_constraintStart_toEndOf="@+id/actionsContainer"
            app:layout_constraintTop_toTopOf="@+id/actionsContainer" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/entryImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurfaceVariant"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
